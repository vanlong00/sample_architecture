{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter: pub get",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": []
    },
    {
      "label": "flutter: build_runner build",
      "type": "shell",
      "command": "flutter pub run build_runner build --delete-conflicting-outputs",
      "detail": "Sinh code Freezed / json_serializable / retrofit / injectable / flutter_gen (asset)",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "flutter: build_runner watch",
      "type": "shell",
      "command": "flutter pub run build_runner watch --delete-conflicting-outputs",
      "detail": "Tự sinh lại code mỗi khi lưu file (chạy nền)",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "flutter: gen-l10n",
      "type": "shell",
      "command": "flutter gen-l10n",
      "detail": "Sinh AppLocalizations sau khi sửa file .arb",
      "problemMatcher": []
    },
    {
      "label": "flutter: analyze",
      "type": "shell",
      "command": "flutter analyze",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": ["$dart-analyze"]
    },
    {
      "label": "flutter: test",
      "type": "shell",
      "command": "flutter test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "flutter: run (dev)",
      "type": "shell",
      "command": "flutter run -t lib/main_dev.dart --flavor dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "flutter: run (staging)",
      "type": "shell",
      "command": "flutter run -t lib/main_staging.dart --flavor staging",
      "problemMatcher": []
    },
    {
      "label": "flutter: run (prod)",
      "type": "shell",
      "command": "flutter run -t lib/main_prod.dart --flavor prod",
      "problemMatcher": []
    },
    {
      "label": "flutter: generate all (pub get + build_runner + gen-l10n)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "flutter: pub get",
        "flutter: build_runner build",
        "flutter: gen-l10n"
      ],
      "problemMatcher": []
    }
  ]
