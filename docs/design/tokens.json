{
  "$schema-note": "Busmod design tokens v1 (2026-10-30). Color roles map 1:1 to Flutter ColorScheme fields. `color` and `contrast` are written by tools/contrast.py; edit colors there.",
  "seed": {
    "decision": "No fromSeed. Explicit ColorScheme(...) for light and dark built from the values in `color`. Keep AppColors.seed = #FFB547 only as the documented brand anchor.",
    "brandAnchor": "#FFB547"
  },
  "typography": {
    "families": {
      "display": {
        "name": "Barlow Condensed",
        "license": "SIL OFL 1.1",
        "weights": [
          600,
          700
        ],
        "fallback": "sans-serif-condensed (Roboto Condensed on Android)"
      },
      "text": {
        "name": "Barlow",
        "license": "SIL OFL 1.1",
        "weights": [
          400,
          500,
          600
        ],
        "fallback": "Roboto (Android system)"
      }
    },
    "scale": {
      "displaySmall": {
        "family": "display",
        "size": 36,
        "lineHeight": 44,
        "weight": 700,
        "letterSpacing": 0
      },
      "headlineMedium": {
        "family": "display",
        "size": 28,
        "lineHeight": 36,
        "weight": 700,
        "letterSpacing": 0
      },
      "headlineSmall": {
        "family": "display",
        "size": 26,
        "lineHeight": 32,
        "weight": 600,
        "letterSpacing": 0
      },
      "titleLarge": {
        "family": "display",
        "size": 24,
        "lineHeight": 30,
        "weight": 600,
        "letterSpacing": 0
      },
      "titleMedium": {
        "family": "display",
        "size": 19,
        "lineHeight": 24,
        "weight": 600,
        "letterSpacing": 0.1
      },
      "titleSmall": {
        "family": "text",
        "size": 14,
        "lineHeight": 20,
        "weight": 600,
        "letterSpacing": 0.1
      },
      "bodyLarge": {
        "family": "text",
        "size": 16,
        "lineHeight": 24,
        "weight": 400,
        "letterSpacing": 0.15
      },
      "bodyMedium": {
        "family": "text",
        "size": 14,
        "lineHeight": 20,
        "weight": 400,
        "letterSpacing": 0.2
      },
      "bodySmall": {
        "family": "text",
        "size": 12,
        "lineHeight": 16,
        "weight": 400,
        "letterSpacing": 0.3
      },
      "labelLarge": {
        "family": "text",
        "size": 15,
        "lineHeight": 20,
        "weight": 600,
        "letterSpacing": 0.2
      },
      "labelMedium": {
        "family": "text",
        "size": 12,
        "lineHeight": 16,
        "weight": 600,
        "letterSpacing": 0.4
      },
      "labelSmall": {
        "family": "text",
        "size": 11,
        "lineHeight": 16,
        "weight": 600,
        "letterSpacing": 0.6
      }
    },
    "rules": [
      "Line height never below 1.2x the font size: Vietnamese stacked diacritics (Ẫ, Ở, Ữ) clip otherwise.",
      "Uppercase only for plates (type names, wordmark); never for sentences, the Ad badge or Vietnamese body copy.",
      "Digits in sizes, counts and percentages use FontFeature.tabularFigures()."
    ]
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "pageGutter": 16,
    "cardGap": 12
  },
  "radius": {
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 28,
    "full": 999,
    "use": {
      "plate": "xs",
      "thumbnailInTile": "s",
      "chip": "s",
      "card": "m",
      "adCell": "m",
      "button": "full",
      "bottomSheetTop": "xl",
      "dialog": "xl",
      "searchField": "full",
      "snackbar": "s"
    }
  },
  "elevation": {
    "level0": 0,
    "level1": 1,
    "level2": 3,
    "level3": 6,
    "use": {
      "card": "level0 on surfaceContainerLow (no shadow)",
      "appBarScrolled": "level2 (tonal, surfaceContainer)",
      "navigationBar": "level2 surfaceContainer",
      "ctaBar": "level2 surfaceContainerHigh + top 1dp outlineVariant divider",
      "bottomSheet": "level1 surfaceContainerLow",
      "dialog": "level3 surfaceContainerHigh",
      "snackbar": "level3 inverseSurface"
    }
  },
  "motion": {
    "duration": {
      "short": 150,
      "medium": 250,
      "long": 400
    },
    "easing": {
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "decelerate": [
        0.05,
        0.7,
        0.1,
        1.0
      ],
      "accelerate": [
        0.3,
        0.0,
        0.8,
        0.15
      ]
    },
    "use": {
      "chipSelect": "short standard",
      "ctaStateChange": "medium standard (AnimatedSwitcher, fade + size)",
      "bottomSheet": "Material default",
      "pageTransition": "Material default (fade-forwards)",
      "progress": "linear, updates <= 4 per second",
      "galleryPage": "medium decelerate"
    },
    "reducedMotion": "When MediaQuery.disableAnimationsOf(context) is true, all durations become 0 except the progress bar fill."
  },
  "icons": {
    "set": "Material Icons, outlined style (Icons.*_outlined), filled for selected nav and toggled favorite",
